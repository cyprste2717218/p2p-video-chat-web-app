{
  "name": "video-chat-application",
  "version": "1.0.0",
  "description": "Video chat application",
  "main": "other.js",
  "scripts": {
    "run-all": "concurrently \"npm run run-signalling-api\" \"npm run run-video-chat-frontend\"",
    "run-video-chat-frontend": "cd web-server && docker compose watch web-server-dev",
    "build-video-chat-frontend": "cd web-server && npm run build",
    "run-built-video-chat-frontend": "cd web-server && node ./dist/server/entry.mjs",
    "run-signalling-api": "cd web-socket-api/src && node --env-file=.env app.js",
    "test": "xo",
    "prepare": "husky install",
    "gcp-deploy-dev": "cd infra && pulumi up",
    "gcp-destroy-dev": "cd infra && pulumi destroy"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "xo": "^2.0.2"
  },
  "lint-staged": {
    "*.{js,css}": "xo --prettier"
  }
}