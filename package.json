{
  "name": "voneo-video-chat-app",
  "version": "1.0.0",
  "description": "P2P Video Chat Web App built with Express.js, WebSockets & WebRTC",
  "scripts": {
    "setup:win": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "setup:unix": "bash setup.sh",
    "dev": "concurrently \"npm run run-signalling-api\" \"npm run run-video-chat-frontend\"",
    "halt-dev": "concurrently \"npm run halt-local-db\" \"npm run halt-signalling-api\" \"npm run halt-video-chat-frontend\"",
    "run-video-chat-frontend": "docker compose --env-file .env -f web-server/src/compose.yaml watch web-server-dev",
    "run-signalling-api": "docker compose --env-file .env -f web-socket-api/src/compose.yaml watch signalling-server-dev",
    "halt-local-db": "cd web-socket-api/src && docker compose down mysql-db",
    "halt-video-chat-frontend": "docker compose --env-file .env -f web-server/src/compose.yaml down web-server-dev",
    "halt-signalling-api": "docker compose --env-file .env -f web-socket-api/src/compose.yaml down signalling-server-dev",
    "build-video-chat-frontend": "cd web-server/src && npm run build",
    "test:it": "cd web-socket-api/src && npm run test:it",
    "test": "xo",
    "lint": "xo --prettier",
    "lint:fix": "xo --prettier --fix",
    "prepare": "husky install",
    "gcp-deploy-dev": "cd infra && pulumi up",
    "gcp-destroy-dev": "cd infra && pulumi destroy",
    "nuke:win": "powershell -ExecutionPolicy Bypass -File nuke.ps1",
    "nuke:unix": "bash nuke.sh",
    "tunnel": "ngrok start --all --config ngrok.yml"
  },
  "author": "cyprste2717218",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^10.0.3",
    "husky": "^9.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "xo": "^2.0.2"
  },
  "lint-staged": {
    "*.{ts,js,css}": "xo --prettier --fix"
  }
}